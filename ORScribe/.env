# API
API_HOST=0.0.0.0
API_PORT=8030
API_KEY=change-me-to-a-secure-random-key
LOG_LEVEL=INFO
API_RELOAD=false

# OpenAI — copy your key from ConvoScribe/.env or set USE_LLM_STUB=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=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
ROLE_ID_MODEL=gpt-4o
RECORD_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0
ENABLE_USAGE_TRACKING=true
USE_LLM_STUB=true
ROLE_CONFIDENCE_THRESHOLD=medium

# PostgreSQL (localhost ports when running API on host; use postgres:5432 inside Docker)
DATABASE_URL=postgresql://orscribe:orscribe@localhost:5434/orscribe

# Redis / Celery (localhost ports when running API on host)
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/0
CELERY_RESULT_BACKEND=redis://localhost:6381/1

# S3-compatible object storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=orscribe-audio
S3_REGION=us-east-1
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# Transcription
TRANSCRIPTION_BACKEND=whisper
WHISPER_MODEL_SIZE=base
PYANNOTE_HF_TOKEN=
MAX_AUDIO_DURATION_SECONDS=14400
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a
CHUNK_DURATION_SECONDS=600

# Retention
AUDIO_RETENTION_DAYS=30
