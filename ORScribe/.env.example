# API
API_HOST=0.0.0.0
API_PORT=8030
API_KEY=change-me-to-a-secure-random-key
LOG_LEVEL=INFO
API_RELOAD=false

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
ROLE_ID_MODEL=gpt-4o
RECORD_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0
ENABLE_USAGE_TRACKING=true
USE_LLM_STUB=false
ROLE_CONFIDENCE_THRESHOLD=medium

# PostgreSQL
# Host (py main.py): localhost:5434  |  Docker (api/worker): postgres:5432
DATABASE_URL=postgresql://orscribe:orscribe@localhost:5434/orscribe

# Redis / Celery
# Host: localhost:6381  |  Docker: redis:6379
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/0
CELERY_RESULT_BACKEND=redis://localhost:6381/1

# S3-compatible object storage (MinIO)
# Host: localhost:9002  |  Docker: http://minio:9000
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=orscribe-audio
S3_REGION=us-east-1
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# Transcription
# stub = fixed sample text (ignores audio — dev/CI only)
# whisper = real STT via faster-whisper (recommended for ORVoiceAgent)
# whisper_pyannote = faster-whisper + speaker diarization (needs PYANNOTE_HF_TOKEN)
TRANSCRIPTION_BACKEND=whisper
WHISPER_MODEL_SIZE=base
PYANNOTE_HF_TOKEN=
MAX_AUDIO_DURATION_SECONDS=14400
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a
CHUNK_DURATION_SECONDS=600

# Retention
AUDIO_RETENTION_DAYS=30
