            {
              "key": "audio",
              "type": "file",
              "src": [],
              "description": "Select a .wav, .mp3, or .m4a file"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cases",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cases"]
        },
        "description": "Start a post-hoc case with a single audio file. Returns 202 Accepted with case_id. Poll Get Case until status is completed."
      },
      "response": [
