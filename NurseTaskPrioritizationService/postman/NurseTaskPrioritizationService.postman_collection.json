  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Check service health and OpenAI API status"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Prioritize Tasks (Minimal)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"req-postman-001\",\n  \"unit_context\": {\n    \"unit_name\": \"Medical Ward A\",\n    \"shift\": \"day\",\n    \"generated_at\": \"2026-03-16T09:00:00Z\"\n  },\n  \"nurse_context\": {\n    \"nurse_id\": \"N-204\",\n    \"assigned_rooms\": [\"101\", \"102\"]\n  },\n  \"patients\": [\n    {\n      \"patient_id\": \"P-1001\",\n      \"room\": \"101\",\n      \"patient_risk_flags\": [],\n      \"vitals\": [],\n      \"lab_alerts\": [],\n      \"medication_tasks\": [],\n      \"nursing_tasks\": [\n        {\n          \"task_id\": \"TASK-1\",\n          \"title\": \"Vital signs check\",\n          \"due_time\": \"2026-03-16T09:30:00Z\",\n          \"status\": \"pending\"\n        }\n      ],\n      \"notes\": []\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/prioritize-tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "prioritize-tasks"]
        },
        "description": "Prioritize tasks with minimal patient data"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has field prioritized_tasks', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('prioritized_tasks');",
              "});",
              "pm.test('prioritized_tasks is an array', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.prioritized_tasks).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Prioritize Tasks (Full Example)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"req-001\",\n  \"unit_context\": {\n    \"unit_name\": \"Medical Ward A\",\n    \"shift\": \"day\",\n    \"generated_at\": \"2026-03-16T09:00:00Z\"\n  },\n  \"nurse_context\": {\n    \"nurse_id\": \"N-204\",\n    \"assigned_rooms\": [\"101\", \"102\", \"103\", \"104\"]\n  },\n  \"patients\": [\n    {\n      \"patient_id\": \"P-1001\",\n      \"room\": \"101\",\n      \"patient_risk_flags\": [\"fall_risk\"],\n      \"vitals\": [\n        {\n          \"name\": \"oxygen_saturation\",\n          \"value\": \"88\",\n          \"unit\": \"%\",\n          \"timestamp\": \"2026-03-16T08:55:00Z\"\n        },\n        {\n          \"name\": \"heart_rate\",\n          \"value\": \"118\",\n          \"unit\": \"bpm\",\n          \"timestamp\": \"2026-03-16T08:55:00Z\"\n        }\n      ],\n      \"lab_alerts\": [\n        {\n          \"name\": \"potassium\",\n          \"value\": \"2.9\",\n          \"unit\": \"mmol/L\",\n          \"flag\": \"low\",\n          \"timestamp\": \"2026-03-16T08:40:00Z\"\n        }\n      ],\n      \"medication_tasks\": [\n        {\n          \"task_id\": \"MED-1\",\n          \"medication_name\": \"Insulin\",\n          \"due_time\": \"2026-03-16T09:05:00Z\",\n          \"status\": \"pending\",\n          \"priority_hint\": \"time_sensitive\"\n        }\n      ],\n      \"nursing_tasks\": [\n        {\n          \"task_id\": \"TASK-1\",\n          \"title\": \"Reassess oxygen therapy\",\n          \"due_time\": \"2026-03-16T09:00:00Z\",\n          \"status\": \"pending\"\n        },\n        {\n          \"task_id\": \"TASK-2\",\n          \"title\": \"Fall prevention rounding\",\n          \"due_time\": \"2026-03-16T09:20:00Z\",\n          \"status\": \"pending\"\n        }\n      ],\n      \"notes\": [\n        {\n          \"type\": \"nurse_note\",\n          \"timestamp\": \"2026-03-16T08:30:00Z\",\n          \"text\": \"Patient short of breath during ambulation.\"\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/prioritize-tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "prioritize-tasks"]
        },
        "description": "Prioritize tasks with full patient data example"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has field prioritized_tasks', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property('prioritized_tasks');",
              "});",
              "pm.test('prioritized_tasks is an array', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.prioritized_tasks).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
