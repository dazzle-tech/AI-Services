# Service
SERVICE_NAME=radiology-qc-ai

# Safety / regulatory disclaimer (returned in QC API responses)
DISCLAIMER_TEXT="Research/MVP only. Not for clinical use without validation and regulatory approval."

# QC behavior
BLADDER_MISSING_IS_FAIL=false

# Optional OpenAI report generation (text only; never used for detection)
OPENAI_ENABLED=false
# Default local Ollama endpoint. Leave OPENAI_BASE_URL empty and provide a real
# OPENAI_API_KEY to switch the same code path back to the OpenAI cloud API.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b
DEIDENTIFY_BEFORE_GPT=true

# API (used by local `python main.py` runs; container uses uvicorn CMD)
API_HOST=0.0.0.0
API_PORT=8016
API_RELOAD=false

# Logging
LOG_LEVEL=INFO
