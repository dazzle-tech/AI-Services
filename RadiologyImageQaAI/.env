# Service
SERVICE_NAME=radiology-qc-ai

# Safety / regulatory disclaimer (returned in QC API responses)
DISCLAIMER_TEXT="Research/MVP only. Not for clinical use without validation and regulatory approval."

# QC behavior
BLADDER_MISSING_IS_FAIL=false

# Optional OpenAI report generation (text only; never used for detection)
OPENAI_ENABLED=false
# Default local Ollama endpoint. Leave OPENAI_BASE_URL empty to use the OpenAI
# cloud endpoint with the configured key instead.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
DEIDENTIFY_BEFORE_GPT=true

# API (used by local `python main.py` runs; container uses uvicorn CMD)
API_HOST=0.0.0.0
API_PORT=8016
API_RELOAD=false

# Logging
LOG_LEVEL=INFO