API_HOST=0.0.0.0
API_PORT=8012
API_RELOAD=false

# OCR
OCR_LANGUAGES=en
OCR_GPU=false
OCR_PREPROCESS=true
OCR_MIN_AVG_CONFIDENCE=0.35
OCR_LOW_CONFIDENCE_THRESHOLD=0.20
OCR_LOW_CONFIDENCE_FRACTION_THRESHOLD=0.55
OCR_MIN_LINES=3

# Parsing (Ollama)
OLLAMA_COMMAND=ollama
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120
