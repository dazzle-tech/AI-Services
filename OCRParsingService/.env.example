API_HOST=0.0.0.0
API_PORT=8012
API_RELOAD=false

# OCR
OCR_LANGUAGES=en
OCR_GPU=false
OCR_PREPROCESS=true
OCR_MIN_AVG_CONFIDENCE=0.35
OCR_LOW_CONFIDENCE_THRESHOLD=0.20
OCR_LOW_CONFIDENCE_FRACTION_THRESHOLD=0.55
OCR_MIN_LINES=3
OCR_RETURN_BOXES=true
OCR_USE_MODEL_CONFIDENCE_FOR_QUALITY=false
OCR_FIELD_HIGH_CONFIDENCE=0.90
OCR_FIELD_MEDIUM_CONFIDENCE=0.70

# Structured extraction (OpenAI)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
# Vision OCR and structured parsing both use this model.
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=
OPENAI_VISION_TIMEOUT=30
OPENAI_VISION_DETAIL=high
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0
