# OpenAI-compatible endpoint configuration. Leave OPENAI_BASE_URL empty to use
# the cloud OpenAI endpoint with the configured key instead of local Ollama.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0

# Embeddings model for the local RAG store
OPENAI_EMBED_MODEL=text-embedding-3-small

# RAG / domain data files (relative to project root)
ICD10_FILE=rag_data/icd10cm.json
RADLEX_FILE=rag_data/radlex.json
RAG_EMBEDDINGS_FILE=rag_data/embeddings.npz
TERMS_GUIDE_FILE=medical_terms_guide.txt
OUTPUT_SCHEMA_FILE=output_schema.json

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8024
API_RELOAD=false

# Output persistence (every AI call is written to ./output as PHI-bearing JSON)
PERSIST_OUTPUT=true