{
  "info": {
    "name": "medical image report correction",
    "description": "Postman collection for the FastAPI service in this repo (Medical Imaging Assist). Set `baseUrl` as needed (default: http://localhost:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Root",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      }
    },
    {
      "name": "Terms Summary",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/terms/summary"
      }
    },
    {
      "name": "Report Filling - Greek Abdominal Ultrasound",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"PatientID\": \"P12345\",\n  \"PatientName\": \"John Doe\",\n  \"OrderID\": \"ORD-001\",\n  \"OrderDate\": \"2026-06-04T00:00:00\",\n  \"DateOfBirth\": \"1980-01-15T00:00:00\",\n  \"NationalID\": \"123456789\",\n  \"Gender\": \"Male\",\n  \"AccessionNumber\": \"ACC-10008\",\n  \"OutputLanguage\": \"el\",\n  \"ExamType\": \"ΥΠΕΡΗΧΟΓΡΑΦΗΜΑ ΑΝΩ ΚΑΙ ΚΑΤΩ ΚΟΙΛΙΑΣ\",\n  \"DoctorNotes\": \"\",\n  \"RadiologistNotes\": \"\",\n  \"DICOM\": {\n    \"Modality\": \"US\",\n    \"BodyPartExamined\": \"ABDOMEN\",\n    \"StudyDate\": \"20260604\"\n  }\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/report-filling"
      }
    },
    {
      "name": "Report Filling - Portuguese Abdominal Ultrasound",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"PatientID\": \"P12345\",\n  \"PatientName\": \"John Doe\",\n  \"OrderID\": \"ORD-001\",\n  \"OrderDate\": \"2026-06-04T00:00:00\",\n  \"DateOfBirth\": \"1980-01-15T00:00:00\",\n  \"NationalID\": \"123456789\",\n  \"Gender\": \"Male\",\n  \"AccessionNumber\": \"ACC-10008\",\n  \"OutputLanguage\": \"pt\",\n  \"ExamType\": \"Ecografia abdominal\",\n  \"DoctorNotes\": \"\",\n  \"RadiologistNotes\": \"\",\n  \"DICOM\": {\n    \"Modality\": \"US\",\n    \"BodyPartExamined\": \"ABDOMEN\",\n    \"StudyDate\": \"20260604\"\n  }\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/report-filling"
      }
    }
  ]
}
