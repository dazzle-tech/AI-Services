{
  "info": {
    "name": "Medical Imaging Assist",
    "description": "Postman collection for the RadiologyReportFilling service (Medical Imaging Assist). Default port 8024. Set `base_url` as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8024"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Service reports healthy or degraded status', function () {",
              "  pm.expect(body.status).to.be.oneOf(['healthy', 'degraded']);",
              "});",
              "",
              "pm.test('Response identifies medical-imaging-assist service', function () {",
              "  pm.expect(body.service).to.eql('medical-imaging-assist');",
              "});",
              "",
              "pm.test('Response includes openai_configured flag', function () {",
              "  pm.expect(body.openai_configured).to.be.a('boolean');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "description": "Liveness and configuration check.",
        "url": "{{base_url}}/api/v1/health"
      }
    },
    {
      "name": "Terms Summary",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('ICD-10 term count is loaded', function () {",
              "  pm.expect(body.icd10_count).to.be.at.least(30);",
              "});",
              "",
              "pm.test('RadLex term count is loaded', function () {",
              "  pm.expect(body.radlex_count).to.be.at.least(30);",
              "});",
              "",
              "pm.test('Embeddings presence flag is returned', function () {",
              "  pm.expect(body.embeddings_present).to.be.a('boolean');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "description": "Loaded ICD-10 and RadLex counts (no AI call).",
        "url": "{{base_url}}/api/v1/terms/summary"
      }
    },
    {
      "name": "Report Correction - Laterality Conflict",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('clinical_report_text uses radiologist notes as base', function () {",
              "  pm.expect(body.clinical_report_text).to.include('right lower lobe');",
              "});",
              "",
              "pm.test('Response is not auto-confirmed', function () {",
              "  pm.expect(body.confirmed).to.eql(false);",
              "});",
              "",
              "pm.test('Laterality conflict warning is present', function () {",
              "  const codes = (body.warnings || []).map((w) => w.code);",
              "  pm.expect(codes).to.include('LATERALITY_CONFLICT');",
              "});",
              "",
              "pm.test('safety_normalized_output mirrors clinical report', function () {",
              "  pm.expect(body.safety_normalized_output).to.be.an('object');",
              "  pm.expect(body.safety_normalized_output.clinical_report).to.eql(body.clinical_report_text);",
              "  pm.expect(body.safety_normalized_output.rag_grounding).to.have.property('icd10_codes');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Uses radiologist_notes as the base report, flags contradictions against doctor_notes, and returns clinical_report_text.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctor_notes\": \"Patient presenting with acute chest pain and persistent cough. Suspected left-sided pneumonia.\",\n  \"radiologist_notes\": \"PA/Lateral Chest: Consolidation and opacity noted in the right lower lobe. No evidence of pneumothorax.\",\n  \"exam_type\": \"Chest X-ray 2 Views\",\n  \"extracted_dicom_metadata\": {\n    \"PatientID\": \"12345\",\n    \"Modality\": \"CR\",\n    \"BodyPartExamined\": \"CHEST\",\n    \"ViewPosition\": \"PA\",\n    \"StudyDate\": \"20260513\"\n  }\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/report-correction"
      }
    },
    {
      "name": "Analysis Matching - Hierarchy Of Truth",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('reconciled_findings is returned', function () {",
              "  pm.expect(body.reconciled_findings).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('Each finding has a valid match_status', function () {",
              "  body.reconciled_findings.forEach((finding) => {",
              "    pm.expect(finding.match_status).to.be.oneOf(['matched', 'partial', 'unmatched']);",
              "  });",
              "});",
              "",
              "pm.test('suggested_icd10_codes is returned', function () {",
              "  pm.expect(body.suggested_icd10_codes).to.be.an('array');",
              "});",
              "",
              "pm.test('safety_normalized_output mirrors reconciled findings', function () {",
              "  pm.expect(body.safety_normalized_output.reconciled_findings).to.eql(body.reconciled_findings);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Compares AI findings against the clinical report and returns reconciled_findings with ICD-10 suggestions.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clinical_report\": \"Follow-up of pulmonary nodule. A stable 1.2cm nodule is noted in the left upper lobe.\",\n  \"ai_image_analysis\": {\n    \"findings\": [\n      {\n        \"label\": \"Nodule\",\n        \"location\": \"Left Upper Lobe\",\n        \"size_mm\": 18,\n        \"confidence\": 0.92\n      }\n    ]\n  },\n  \"extracted_dicom_metadata\": {\n    \"Modality\": \"DX\",\n    \"ViewPosition\": \"PA\",\n    \"StudyDescription\": \"CHEST SINGLE VIEW\"\n  }\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/analysis-matching"
      }
    },
    {
      "name": "Report Filling - Static Template Test",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Response has TEMPLATE_NAME', function () {",
              "  pm.expect(body).to.have.property('TEMPLATE_NAME');",
              "});",
              "",
              "pm.test('Response has TEMPLATE_TEXT', function () {",
              "  pm.expect(body).to.have.property('TEMPLATE_TEXT');",
              "});",
              "",
              "pm.test('TEMPLATE_TEXT is not empty', function () {",
              "  pm.expect(body.TEMPLATE_TEXT).to.be.a('string');",
              "  pm.expect(body.TEMPLATE_TEXT.trim().length).to.be.above(0);",
              "});",
              "",
              "pm.test('Response uses template-only contract', function () {",
              "  pm.expect(body).to.have.property('ID');",
              "  pm.expect(body).to.not.have.property('safety_normalized_output');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Template-generation endpoint driven by patient/order/DICOM metadata. Fast smoke test with metadata-only input.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"PatientID\": \"P12345\",\n  \"PatientName\": \"John Doe\",\n  \"OrderID\": \"ORD-001\",\n  \"OrderDate\": \"2026-06-04T00:00:00\",\n  \"DateOfBirth\": \"1980-01-15T00:00:00\",\n  \"NationalID\": \"123456789\",\n  \"Gender\": \"Male\",\n  \"AccessionNumber\": \"ACC-10008\",\n  \"OutputLanguage\": \"el\",\n  \"ExamType\": \"ΥΠΕΡΗΧΟΓΡΑΦΗΜΑ ΑΝΩ ΚΑΙ ΚΑΤΩ ΚΟΙΛΙΑΣ\",\n  \"DoctorNotes\": \"\",\n  \"RadiologistNotes\": \"\",\n  \"DICOM\": {\n    \"Modality\": \"US\",\n    \"BodyPartExamined\": \"ABDOMEN\",\n    \"StudyDate\": \"20260604\"\n  }\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/v1/report-filling"
      }
    }
  ]
}
