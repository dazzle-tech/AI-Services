# OpenAI-compatible endpoint configuration.
# Default: local Ollama. Leave OPENAI_BASE_URL empty and provide a real
# OPENAI_API_KEY to route the same SDK client back to the OpenAI cloud API.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_DELAY=1.0

# Embeddings model for the local RAG store
OPENAI_EMBED_MODEL=nomic-embed-text

# RAG / domain data files (relative to project root)
ICD10_FILE=rag_data/icd10cm.json
RADLEX_FILE=rag_data/radlex.json
RAG_EMBEDDINGS_FILE=rag_data/embeddings.npz
TERMS_GUIDE_FILE=medical_terms_guide.txt
OUTPUT_SCHEMA_FILE=output_schema.json

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Output persistence (every AI call is written to ./output as PHI-bearing JSON)
PERSIST_OUTPUT=true
