  "TEMPLATE_NAME": "\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0623\u0634\u0639\u0629",
  "TEMPLATE_TEXT": "\u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0623\u0634\u0639\u0629\n\n\u0627\u0644\u0627\u0633\u062a\u0637\u0628\u0627\u0628 \u0627\u0644\u0633\u0631\u064a\u0631\u064a: \u0627\u0644\u0645\u0631\u064a\u0636 \u064a\u0639\u0627\u0646\u064a \u0645\u0646 \u0623\u0644\u0645 \u062d\u0627\u062f \u0641\u064a \u0627\u0644\u0635\u062f\u0631 \u0648\u0633\u0639\u0627\u0644 \u0645\u0633\u062a\u0645\u0631. \u064a\u0634\u062a\u0628\u0647 \u0641\u064a \u0648\u062c\u0648\u062f \u0627\u0644\u062a\u0647\u0627\u0628 \u0631\u0626\u0648\u064a \u0641\u064a \u0627\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u0623\u064a\u0633\u0631.\n\u0627\u0644\u0637\u0631\u064a\u0642\u0629: \u0623\u064f\u062c\u0631\u064a \u0627\u0644\u0641\u062d\u0635 \u0648\u0641\u0642 \u0627\u0644\u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0645\u0639\u062a\u0627\u062f \u0641\u064a \u0627\u0644\u0642\u0633\u0645.\n\n\u0627\u0644\u0646\u062a\u0627\u0626\u062c:\n\u062a\u0645 \u0645\u0644\u0627\u062d\u0638\u0629 \u062a\u0643\u062b\u0641 \u0648\u0639\u062a\u0645\u0629 \u0641\u064a \u0627\u0644\u0641\u0635 \u0627\u0644\u0633\u0641\u0644\u064a \u0627\u0644\u0623\u064a\u0645\u0646. \u0644\u0627 \u064a\u0648\u062c\u062f \u062f\u0644\u064a\u0644 \u0639\u0644\u0649 \u0648\u062c\u0648\u062f \u0627\u0633\u062a\u0631\u0648\u0627\u062d \u0627\u0644\u0635\u062f\u0631.\n\u0644\u0627 \u064a\u0648\u062c\u062f \u0633\u0627\u0626\u0644 \u062d\u0631 \u0623\u0648 \u062a\u062c\u0645\u0639.\n\u0627\u0644\u0647\u064a\u0627\u0643\u0644 \u0627\u0644\u062a\u0634\u0631\u064a\u062d\u064a\u0629 \u0636\u0645\u0646 \u0627\u0644\u062d\u062f\u0648\u062f \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629.\n\n\u0645\u0648\u062c\u0648\u062f\u0627\u062a \u0623\u062e\u0631\u0649 \u0645\u0646 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a:\nsurgical clips \u0641\u064a \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0639\u0644\u0648\u064a \u0627\u0644\u0623\u064a\u0633\u0631 \u0645\u0646 \u0627\u0644\u0628\u0637\u0646. \u064a\u0644\u0632\u0645 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u062e\u062a\u0635\u0627\u0635\u064a \u0627\u0644\u0623\u0634\u0639\u0629.\ndegenerative changes \u0641\u064a \u0627\u0644\u0639\u0645\u0648\u062f \u0627\u0644\u0641\u0642\u0631\u064a \u0627\u0644\u0635\u062f\u0631\u064a. \u064a\u0644\u0632\u0645 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u062e\u062a\u0635\u0627\u0635\u064a \u0627\u0644\u0623\u0634\u0639\u0629.\n\n\u0627\u0644\u0627\u0646\u0637\u0628\u0627\u0639:\n\u0644\u0627 \u062a\u0648\u062c\u062f \u062d\u0627\u0644\u0629 \u0625\u0634\u0639\u0627\u0639\u064a\u0629 \u0645\u0647\u0645\u0629 \u0641\u064a \u0627\u0644\u062a\u0642\u064a\u064a\u0645 \u0627\u0644\u062d\u0627\u0644\u064a.",
