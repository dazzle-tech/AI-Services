  "ID": 0,
  "TEMPLATE_NAME": "\u0391\u03ba\u03c4\u03b9\u03bd\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u0398\u03ce\u03c1\u03b1\u03ba\u03bf\u03c2",
  "TEMPLATE_TEXT": "\u0391\u039a\u03a4\u0399\u039d\u039f\u0393\u03a1\u0391\u03a6\u0399\u0391 \u0398\u03a9\u03a1\u0391\u039a\u039f\u03a3\n\n\u0391\u03c3\u03b8\u03b5\u03bd\u03ae\u03c2: John Doe\n\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u0393\u03ad\u03bd\u03bd\u03b7\u03c3\u03b7\u03c2: 15 \u0399\u03b1\u03bd\u03bf\u03c5\u03b1\u03c1\u03af\u03bf\u03c5 1980\n\u0391\u03c1\u03b9\u03b8\u03bc\u03cc\u03c2 \u0395\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae\u03c2: ACC-10008\n\n\u0397\u03bc\u03b5\u03c1\u03bf\u03bc\u03b7\u03bd\u03af\u03b1 \u0395\u03be\u03ad\u03c4\u03b1\u03c3\u03b7\u03c2: 4 \u0399\u03bf\u03c5\u03bd\u03af\u03bf\u03c5 2026\n\n\u03a0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae:\n\u0397 \u03b1\u03ba\u03c4\u03b9\u03bd\u03bf\u03b3\u03c1\u03b1\u03c6\u03af\u03b1 \u03b8\u03ce\u03c1\u03b1\u03ba\u03bf\u03c2 \u03b5\u03ba\u03c4\u03b5\u03bb\u03ad\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03c4\u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bc\u03b5\u03b8\u03cc\u03b4\u03bf\u03c5 CR. \u0397 \u03b5\u03be\u03ad\u03c4\u03b1\u03c3\u03b7 \u03c0\u03b5\u03c1\u03b9\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03b5\u03b9 \u03c4\u03b7\u03bd \u03b1\u03c0\u03b5\u03b9\u03ba\u03cc\u03bd\u03b9\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b8\u03ce\u03c1\u03b1\u03ba\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03be\u03b9\u03bf\u03bb\u03cc\u03b3\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7\u03c2 \u03c4\u03c9\u03bd \u03c0\u03bd\u03b5\u03c5\u03bc\u03cc\u03bd\u03c9\u03bd, \u03c4\u03b7\u03c2 \u03ba\u03b1\u03c1\u03b4\u03b9\u03ac\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03c9\u03bd \u03b3\u03cd\u03c1\u03c9 \u03b4\u03bf\u03bc\u03ce\u03bd.\n\n\u03a3\u03c5\u03bc\u03c0\u03b5\u03c1\u03ac\u03c3\u03bc\u03b1\u03c4\u03b1:\n\u03a4\u03b1 \u03b5\u03c5\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c4\u03b7\u03c2 \u03b5\u03be\u03ad\u03c4\u03b1\u03c3\u03b7\u03c2 \u03b8\u03b1 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03b1\u03be\u03b9\u03bf\u03bb\u03bf\u03b3\u03b7\u03b8\u03bf\u03cd\u03bd \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03b8\u03b5\u03c1\u03ac\u03c0\u03bf\u03bd\u03c4\u03b1 \u03b9\u03b1\u03c4\u03c1\u03cc \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c4\u03b5\u03bb\u03b9\u03ba\u03ae \u03b4\u03b9\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7.\n\n\u039f \u0399\u0391\u03a4\u03a1\u039f\u03a3 \u0391\u039a\u03a4\u0399\u039d\u039f\u039b\u039f\u0393\u039f\u03a3\n\u039c\u0399\u03a7\u0391\u039b\u0397\u03a3 \u039a\u0395\u039b\u039f\u0393\u03a1\u0397\u0393\u039f\u03a1\u0397\u03a3\n(\u03ba\u03c9\u03b4\u03b9\u03ba\u03cc\u03c2 \u0393\u0395\u03a3\u03a5: D2022)",
