# GPU image for LiveVisitScribe. This file has not been built or run.
# Build: docker build -f Dockerfile.gpu -t live-visit-scribe:gpu .
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOST=0.0.0.0 \
    PORT=8037 \
    WHISPER_DEVICE=cuda \
    WHISPER_MODEL_CACHE=/models/whisper \
    HF_HOME=/models/hf

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip libgomp1 && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --upgrade pip && pip3 install -r requirements.txt

COPY . .

RUN useradd -m -u 1000 appuser && mkdir -p /models && chown -R appuser:appuser /app /models
USER appuser

EXPOSE 8037
VOLUME ["/models"]

# First start downloads the Whisper model. Readiness is /api/v1/ready; this check is liveness only.
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8037/api/v1/health')" || exit 1

CMD ["python", "main.py"]
