HOST=0.0.0.0
PORT=8037
LOG_LEVEL=INFO
# Comma-separated browser origins for GET /api/v1/health (the WebSocket is not subject to CORS)
CORS_ORIGINS=*

# Speech: faster-whisper. small is the live default; medium or large-v3 read Arabic better but need a GPU to keep up.
WHISPER_MODEL=small
# auto | cuda | cpu
WHISPER_DEVICE=auto
# float16 (GPU) / int8 (CPU) when blank
WHISPER_COMPUTE_TYPE=
# Blank = auto-detect, which suits Arabic + English visits
WHISPER_LANGUAGE=
WHISPER_MODEL_CACHE=

# Live lines
# A partial line is refreshed this often while someone is talking
STREAM_CHUNK_SECONDS=4
# Audio carried into the next line when a long line is split
STREAM_OVERLAP_SECONDS=0.5
# This much silence ends a line (it becomes final)
SILENCE_MS=800
# Frame energy (0-1) below this counts as silence; raise it for a noisy room
SILENCE_RMS=0.01
MIN_SPEECH_MS=250
MAX_TURN_SECONDS=30
# When this far behind real time, partial lines are skipped
MAX_BACKLOG_SECONDS=2
# Past this much queued audio the visit is refused (the soft backlog above only skips partials)
MAX_BACKLOG_HARD_SECONDS=30

# How many live visits this process accepts at once
MAX_SESSIONS=8
# End a visit after this many seconds of audio (not counting time spent paused)
MAX_SESSION_SECONDS=3600
# One warning this many seconds before the visit is ended for length
SESSION_WARN_SECONDS=2700
# Close the socket if `start` does not arrive
START_TIMEOUT_SECONDS=10
# End the visit when no audio arrives while it is running; the lines already heard are still sent
IDLE_TIMEOUT_SECONDS=30
# Close a visit left paused
PAUSE_TIMEOUT_SECONDS=900
# Refuse one binary frame larger than this
MAX_FRAME_BYTES=524288

# Languages Whisper may settle on, comma-separated. A detection outside the list is remapped to the closest.
WHISPER_LANGUAGES=ar,en
# Optional hint passed to Whisper. Blank sends no hint.
WHISPER_INITIAL_PROMPT=
# Drop a piece when no_speech_prob is above this AND avg_logprob is below the minimum. Missing scores are kept.
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_MIN_AVG_LOGPROB=-1.0
# Drop a piece whose compression ratio is above this (a repeated hallucination)
WHISPER_MAX_COMPRESSION_RATIO=2.4
# true = ask Whisper for per-word probabilities and flag uncertain numbers
WHISPER_WORD_CONFIDENCE=false
WHISPER_LOW_CONFIDENCE=0.6

# "Picked up so far": at most one update per interval, only after a new final line
PICKED_UP_INTERVAL_SECONDS=8
# The gap grows with the number of finished lines, and never exceeds this
PICKED_UP_MAX_INTERVAL_SECONDS=30
# How many picked-up model calls may run at once in this process
EXTRACT_MAX_CONCURRENCY=4
# On stop, send `final` if the last list update is still running after this many seconds
STOP_FLUSH_TIMEOUT_SECONDS=10
LIVE_EXTRACT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint; leave empty for api.openai.com
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=30
# Retries of the picked-up model call by the OpenAI client
OPENAI_MAX_RETRIES=2
# true = scripted lines and deterministic picked-up list: no Whisper model, no API key (tests, demos)
USE_LLM_STUB=false
# true = serve /try, /docs, /redoc and /openapi.json. Leave false on a deployed instance.
ENABLE_DEV_PAGES=false
