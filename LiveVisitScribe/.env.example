HOST=0.0.0.0
PORT=8037
LOG_LEVEL=INFO
# Comma-separated browser origins for GET /api/v1/health (the WebSocket is not subject to CORS)
CORS_ORIGINS=*

# Speech: OpenAI Realtime gpt-live-transcribe (needs OPENAI_API_KEY below)
LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
# minimal | low | medium | high | xhigh — low balances speed and accuracy
LIVE_TRANSCRIBE_DELAY=low
LIVE_TRANSCRIBE_CHAR_MS=0
# Clinic context; tells the model to use digits and English/Arabic only
LIVE_TRANSCRIBE_PROMPT=Doctor-patient clinic visit in English or Arabic only. Transcribe exactly what was spoken. Write all numbers as digits, never as words (2 not two, 4 out of 10 not four out of ten, 36.7 not thirty-six point seven, 128/82 not one hundred twenty-eight over eighty-two, 5 mg not five milligram). Keep medical wording exact: Good morning, blood pressure, headache, amlodipine, nausea, vomiting, fever, dehydration, arrange a review. Do not invent or swap words.
# Comma-separated literal terms that may appear (drug names, etc.). Hints only.
LIVE_TRANSCRIBE_KEYWORDS=Good morning,Dr. Patel,Sarah Johnson,headache,blood pressure,amlodipine,nausea,vomiting,fever,dehydration,arrange a review
# Expected spoken languages for the live model — en and ar only
WHISPER_LANGUAGES=ar,en
# Used as the live prompt when LIVE_TRANSCRIBE_PROMPT is blank
WHISPER_INITIAL_PROMPT=

# Live lines
# A partial line is refreshed this often while someone is talking
STREAM_CHUNK_SECONDS=4
# Audio carried into the next line when a long line is split
STREAM_OVERLAP_SECONDS=0.5
# This much silence ends a line (it becomes final)
SILENCE_MS=800
# Frame energy (0-1) below this counts as silence; raise it for a noisy room
SILENCE_RMS=0.01
MIN_SPEECH_MS=250
MAX_TURN_SECONDS=30
# When this far behind real time, partial lines are skipped
MAX_BACKLOG_SECONDS=2
# Past this much queued audio the visit is refused (the soft backlog above only skips partials)
MAX_BACKLOG_HARD_SECONDS=30

# How many live visits this process accepts at once
MAX_SESSIONS=8
# End a visit after this many seconds of audio (not counting time spent paused)
MAX_SESSION_SECONDS=3600
# One warning this many seconds before the visit is ended for length
SESSION_WARN_SECONDS=2700
# Close the socket if `start` does not arrive
START_TIMEOUT_SECONDS=10
# End the visit when no audio arrives while it is running; the lines already heard are still sent
IDLE_TIMEOUT_SECONDS=30
# Close a visit left paused
PAUSE_TIMEOUT_SECONDS=900
# Refuse one binary frame larger than this
MAX_FRAME_BYTES=524288

# "Picked up so far": at most one update per interval, only after a new final line
# Unused by the live loop now (picked_up is sent after every final). Kept for older deploys.
PICKED_UP_INTERVAL_SECONDS=0
# The gap grows with the number of finished lines, and never exceeds this
PICKED_UP_MAX_INTERVAL_SECONDS=30
# How many picked-up model calls may run at once in this process
EXTRACT_MAX_CONCURRENCY=4
# On stop, wait for the last list update. A full visit can take longer than 10s; cancelling it drops the last lines.
STOP_FLUSH_TIMEOUT_SECONDS=45
LIVE_EXTRACT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Any OpenAI-compatible chat endpoint for the picked-up list; leave empty for api.openai.com.
# Speech always uses the OpenAI Realtime host derived from this (or api.openai.com).
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=30
# Retries of the picked-up model call by the OpenAI client
OPENAI_MAX_RETRIES=2
# true = scripted lines and deterministic picked-up list: no speech API, no key (tests, demos)
USE_LLM_STUB=false
# true = serve /try, /docs, /redoc and /openapi.json. Leave false on a deployed instance.
ENABLE_DEV_PAGES=false
