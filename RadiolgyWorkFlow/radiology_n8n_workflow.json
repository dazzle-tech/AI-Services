        "jsonBody": "={\n  \"PatientID\": \"{{ $('Set Study Data').item.json.patient_id }}\",\n  \"PatientName\": \"{{ $('Set Study Data').item.json.patient_name }}\",\n  \"OrderID\": \"{{ $('Set Study Data').item.json.order_id }}\",\n  \"OrderDate\": \"{{ $('Set Study Data').item.json.order_date }}\",\n  \"DateOfBirth\": \"{{ $('Set Study Data').item.json.date_of_birth }}\",\n  \"NationalID\": \"{{ $('Set Study Data').item.json.national_id }}\",\n  \"Gender\": \"{{ $('Set Study Data').item.json.gender }}\",\n  \"AccessionNumber\": \"{{ $('Set Study Data').item.json.accession_number }}\",\n  \"OutputLanguage\": \"{{ $('Set Study Data').item.json.OutputLanguage }}\",\n  \"ExamType\": \"{{ $('Set Study Data').item.json.exam_type }}\",\n  \"DoctorNotes\": \"{{ $('Set Study Data').item.json.doctor_notes }}\",\n  \"RadiologistNotes\": \"{{ $('Set Study Data').item.json.radiologist_notes }}\",\n  \"AIInterpretation\": {{ JSON.stringify($('Stage 2 - AI Interpretation').item.json) }},\n  \"QCResult\": {{ JSON.stringify($('Stage 1 - Image QA').item.json) }},\n  \"DICOM\": {\n    \"PatientID\": \"{{ $('Set Study Data').item.json.patient_id }}\",\n    \"PatientName\": \"{{ $('Set Study Data').item.json.patient_name }}\",\n    \"OrderID\": \"{{ $('Set Study Data').item.json.order_id }}\",\n    \"OrderDate\": \"{{ $('Set Study Data').item.json.order_date }}\",\n    \"DateOfBirth\": \"{{ $('Set Study Data').item.json.date_of_birth }}\",\n    \"NationalID\": \"{{ $('Set Study Data').item.json.national_id }}\",\n    \"Gender\": \"{{ $('Set Study Data').item.json.gender }}\",\n    \"AccessionNumber\": \"{{ $('Set Study Data').item.json.accession_number }}\",\n    \"Modality\": \"{{ $('Set Study Data').item.json.modality }}\",\n    \"BodyPartExamined\": \"{{ $('Set Study Data').item.json.body_part }}\",\n    \"StudyDate\": \"{{ $('Set Study Data').item.json.study_date }}\"\n  }\n}"
      }
