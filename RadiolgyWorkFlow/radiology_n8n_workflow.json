      "position": [
        700,
        300
      ],
      "notes": "This node expects the DICOM ZIP as incoming binary data in `binary.data`. If you only have `dicom_file_path`, add a Read/Write Files from Disk node (Read) before this to load the file into binary field `data`.",
      "continueOnFail": true,
      "parameters": {
        "url": "={{ ['CR','DX'].includes($('Set Study Data').item.json.modality) ? 'http://localhost:8016/api/v1/qc/xray/dicom' : 'http://localhost:8016/api/v1/qc/ct/dicom' }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            },
            {
              "name": "use_gpt_report",
              "value": "false"
            },
            {
              "name": "OutputLanguage",
              "value": "={{ $('Set Study Data').item.json.OutputLanguage }}"
            }
          ]
        }
      }
    },
