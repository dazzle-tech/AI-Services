# Radiology Workflow PACS configuration example
# Copy this file to `.env` locally if you want to supply environment variables.
# Do not commit real secrets, credentials, or tokens.

# Enable or disable PACS retrieval entirely.
PACS_ENABLED=false

# Select the PACS transport protocol:
# - dicomweb: QIDO-RS / WADO-RS over HTTP(S)
# - dimse:    classic DICOM DIMSE (C-FIND / C-MOVE / C-GET)
PACS_PROTOCOL=dicomweb

# Shared timeout for PACS calls, in seconds.
PACS_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# DICOMweb settings
# Applies when PACS_PROTOCOL=dicomweb
# Example base URL: https://pacs.hospital.local/dicomweb
# ---------------------------------------------------------------------------
PACS_BASE_URL=

# Optional bearer token for Authorization: Bearer <token>
PACS_AUTH_TOKEN=

# Optional basic-auth credentials if your PACS uses username/password auth.
PACS_USERNAME=
PACS_PASSWORD=

# ---------------------------------------------------------------------------
# DIMSE settings
# Applies when PACS_PROTOCOL=dimse
# Example host/port: pacs.hospital.local:104
# ---------------------------------------------------------------------------
PACS_HOST=
PACS_PORT=104

# Our calling AE title for the workflow service.
PACS_AE_TITLE=RADIOLOGY_WORKFLOW

# Remote PACS AE title.
PACS_REMOTE_AE_TITLE=PACS

# Destination AE title used for C-MOVE retrieval workflows.
PACS_MOVE_DESTINATION_AE=

# Workflow HTTP API
API_HOST=127.0.0.1
API_PORT=8090
REPORT_SERVICE_URL=http://127.0.0.1:8024
QC_SERVICE_URL=http://127.0.0.1:8016
INTERP_SERVICE_URL=http://127.0.0.1:8015
AUTOFILL_SERVICE_URL=http://127.0.0.1:8022
