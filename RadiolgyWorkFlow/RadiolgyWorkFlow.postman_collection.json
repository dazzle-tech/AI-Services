    {
      "name": "DICOM",
      "item": [
        {
          "name": "Parse DICOM",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('parse dicom ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('parse_dicom_patient_id', data.patient_id || '');",
                  "pm.collectionVariables.set('parse_dicom_patient_name', data.patient_name || '');",
                  "pm.collectionVariables.set('parse_dicom_patient_sex', data.patient_sex || '');",
                  "pm.collectionVariables.set('parse_dicom_patient_age', data.patient_age || '');",
                  "pm.collectionVariables.set('parse_dicom_modality', data.modality || 'CR');",
                  "pm.collectionVariables.set('parse_dicom_study_date', data.study_date || '');",
                  "pm.collectionVariables.set('parse_dicom_body_part', data.body_part || '');",
                  "pm.collectionVariables.set('parse_dicom_exam_type', data.exam_type || '');",
                  "pm.collectionVariables.set('parse_dicom_accession_number', data.accession_number || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "dicom_file",
                  "type": "file",
                  "src": ""
