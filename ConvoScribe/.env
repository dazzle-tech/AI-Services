ROLE_ID_MODEL=gpt-4o
SUMMARY_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0
USE_LLM_STUB=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8026
API_RELOAD=false
API_KEY=change-me-to-a-secure-random-key
LOG_LEVEL=INFO

# Service Configuration
ENABLE_USAGE_TRACKING=true

# PostgreSQL (localhost ports when running API on host; use postgres:5432 inside Docker)
DATABASE_URL=postgresql://convoscribe:convoscribe@localhost:5433/convoscribe

# Redis / Celery (localhost ports when running API on host)
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# S3-compatible object storage (MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=convoscribe-audio
S3_REGION=us-east-1
S3_USE_SSL=false
S3_SERVER_SIDE_ENCRYPTION=

# Transcription
TRANSCRIPTION_BACKEND=whisper
WHISPER_MODEL_SIZE=base
PYANNOTE_HF_TOKEN=
MAX_AUDIO_DURATION_SECONDS=3600
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a

# Retention
AUDIO_RETENTION_DAYS=30
