# OpenAI Configuration
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
ROLE_ID_MODEL=gpt-4o
SUMMARY_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0
USE_LLM_STUB=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8026
API_RELOAD=false
API_KEY=change-me-to-a-secure-random-key
LOG_LEVEL=INFO

# Service Configuration
ENABLE_USAGE_TRACKING=true

# --- Running API on your machine (py main.py) with infra in Docker ---
# Start infra first: docker compose up postgres redis minio -d
DATABASE_URL=postgresql://convoscribe:convoscribe@localhost:5433/convoscribe
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
S3_ENDPOINT=http://localhost:9000

# --- Running everything in Docker (docker compose up) — use these instead ---
# DATABASE_URL=postgresql://convoscribe:convoscribe@postgres:5432/convoscribe
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# S3_ENDPOINT=http://minio:9000

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=convoscribe-audio
S3_REGION=us-east-1
S3_USE_SSL=false
# Leave empty for MinIO; use AES256 for AWS S3
S3_SERVER_SIDE_ENCRYPTION=

# Transcription
TRANSCRIPTION_BACKEND=stub
WHISPER_MODEL_SIZE=base
PYANNOTE_HF_TOKEN=
MAX_AUDIO_DURATION_SECONDS=3600
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a

# Retention
AUDIO_RETENTION_DAYS=30
