{
  "info": {
    "_postman_id": "lab-result-interpreter-service",
    "name": "LabResultInterpreterService",
    "description": "Postman collection for Lab Result Interpreter Service REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Check service health and OpenAI API status"
      },
      "response": []
    },
    {
      "name": "Interpret Labs (Minimal)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has field interpretation', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('interpretation');",
              "});",
              "",
              "pm.test('interpretation has field key_findings', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.interpretation).to.have.property('key_findings');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"req-lab-minimal-001\",\n  \"lab_results\": [\n    {\n      \"name\": \"WBC\",\n      \"value\": \"10.5\",\n      \"unit\": \"10^9/L\",\n      \"reference_range\": \"4.0-11.0\",\n      \"flag\": \"normal\",\n      \"timestamp\": \"2026-03-16T08:00:00Z\"\n    }\n  ],\n  \"historical_lab_results\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/interpret-labs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "interpret-labs"]
        },
        "description": "Interpret labs with minimal payload (single lab, no patient context or historical)"
      },
      "response": []
    },
    {
      "name": "Interpret Labs (Full Example)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has field interpretation', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('interpretation');",
              "});",
              "",
              "pm.test('interpretation has field key_findings', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.interpretation).to.have.property('key_findings');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"req-lab-001\",\n  \"patient_context\": {\n    \"patient_id\": \"P-1001\",\n    \"age\": 58,\n    \"sex\": \"male\",\n    \"known_conditions\": [\"Type 2 Diabetes\", \"Hypertension\"],\n    \"medications\": [\"Metformin\", \"Lisinopril\"],\n    \"clinical_context\": \"Admitted with fever and shortness of breath\"\n  },\n  \"lab_results\": [\n    {\n      \"name\": \"WBC\",\n      \"value\": \"18.2\",\n      \"unit\": \"10^9/L\",\n      \"reference_range\": \"4.0-11.0\",\n      \"flag\": \"high\",\n      \"timestamp\": \"2026-03-16T08:00:00Z\"\n    },\n    {\n      \"name\": \"CRP\",\n      \"value\": \"145\",\n      \"unit\": \"mg/L\",\n      \"reference_range\": \"0-5\",\n      \"flag\": \"high\",\n      \"timestamp\": \"2026-03-16T08:00:00Z\"\n    },\n    {\n      \"name\": \"Lactate\",\n      \"value\": \"3.4\",\n      \"unit\": \"mmol/L\",\n      \"reference_range\": \"0.5-2.2\",\n      \"flag\": \"high\",\n      \"timestamp\": \"2026-03-16T08:00:00Z\"\n    }\n  ],\n  \"historical_lab_results\": [\n    {\n      \"name\": \"Creatinine\",\n      \"value\": \"1.0\",\n      \"unit\": \"mg/dL\",\n      \"reference_range\": \"0.7-1.3\",\n      \"flag\": \"normal\",\n      \"timestamp\": \"2026-03-14T08:00:00Z\"\n    },\n    {\n      \"name\": \"Creatinine\",\n      \"value\": \"1.8\",\n      \"unit\": \"mg/dL\",\n      \"reference_range\": \"0.7-1.3\",\n      \"flag\": \"high\",\n      \"timestamp\": \"2026-03-16T08:00:00Z\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/interpret-labs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "interpret-labs"]
        },
        "description": "Interpret labs with full example: patient context, multiple abnormal labs, and historical for trend analysis"
      },
      "response": []
    },
    {
      "name": "Interpret Labs (Invalid Payload)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code equals 400 or 422', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"req-invalid-001\",\n  \"lab_results\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/interpret-labs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "interpret-labs"]
        },
        "description": "Test error handling - empty lab_results (should return 400 or 422)"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8003",
      "type": "string"
