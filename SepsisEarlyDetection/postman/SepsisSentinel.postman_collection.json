    },
    {
      "name": "Create Custom Analysis",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient_data\": {\n    \"patient_info\": {\n      \"name\": \"Jane Doe\",\n      \"age\": 58,\n      \"gender\": \"Female\",\n      \"weight_kg\": 65,\n      \"height_cm\": 165,\n      \"bmi\": 23.9,\n      \"blood_type\": \"A+\",\n      \"admission_reason\": \"Suspected UTI\",\n      \"comorbidities\": [\"Diabetes\"],\n      \"allergies\": [\"Penicillin\"]\n    },\n    \"hourly_data\": []\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/analyses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "analyses"
          ]
        }
      }
    },
