API_HOST=0.0.0.0
API_PORT=8036
CONVOSCRIBE_BASE_URL=http://localhost:8026
SYSTEM_DISPLAY_BASE_URL=http://localhost:8031
HTTP_TIMEOUT_SECONDS=180
DEFAULT_VIEW_IDS=soap_note

# Ambient draft (POST /api/v1/draft, /api/v1/sections/regenerate)
# Speech stays on ConvoScribe's TRANSCRIPTION_BACKEND. This only picks the note model.
AMBIENT_NOTE_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-key-here
# Any OpenAI-compatible endpoint; leave empty for api.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEMPERATURE=0.1
OPENAI_TIMEOUT_SECONDS=120
# true = deterministic draft from the transcript, no network (tests, local dev)
USE_LLM_STUB=false
# Segments below this ASR confidence (0-1) mark sentences low_confidence and flag drug names/doses
AMBIENT_LOW_CONFIDENCE_THRESHOLD=0.6
