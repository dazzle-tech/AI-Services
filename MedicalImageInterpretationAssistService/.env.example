SERVICE_NAME=medical-image-interpretation-assist
DISCLAIMER_TEXT="Assistive AI only. Radiologist review required. Not for final diagnosis."
# Local Ollama default. Set OPENAI_BASE_URL="" and provide a real OPENAI_API_KEY
# to switch back to the OpenAI cloud API.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3-vl:8b
VISION_IMAGE_URL_AS_STRING=true
OPENAI_TIMEOUT_SECONDS=30.0
AUDIT_LOG_DIR=/var/log/miias
API_HOST=0.0.0.0
API_PORT=8015
