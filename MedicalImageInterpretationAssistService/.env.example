SERVICE_NAME=medical-image-interpretation-assist
DISCLAIMER_TEXT="Assistive AI only. Radiologist review required. Not for final diagnosis."
API_HOST=0.0.0.0
API_PORT=8015
# OpenAI cloud API. For local Ollama use OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
ENABLE_IMAGE_MODEL=true
VISION_MODEL=gpt-4o
VISION_IMAGE_URL_AS_STRING=false
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=1
AUDIT_LOG_DIR=/var/log/miias
