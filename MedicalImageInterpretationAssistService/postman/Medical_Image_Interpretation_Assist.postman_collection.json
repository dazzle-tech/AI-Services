{
  "info": {
    "name": "Medical Image Interpretation Assist Service (X-ray + CT)",
    "_postman_id": "2da82346-b746-44ab-9cc2-f5387e080cb2",
    "description": "Interpretation assist API collection including X-ray (CR/DX) and CT (CT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/radiology/xray-interpretation/health",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "radiology", "xray-interpretation", "health"]
        }
      }
    },
    {
      "name": "DICOM X-ray Upload (any body part)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "clinical_indication", "type": "text", "value": "Shortness of breath" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/radiology/xray-interpretation/dicom",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "radiology", "xray-interpretation", "dicom"]
        }
      }
    },
    {
      "name": "CT uploaded to X-ray endpoint (expected UNSUPPORTED_MODALITY)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": "" }]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/radiology/xray-interpretation/dicom",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "radiology", "xray-interpretation", "dicom"]
        }
      }
    },
    {
      "name": "CT Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/radiology/ct-interpretation/health",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "radiology", "ct-interpretation", "health"]
        }
      }
    },
    {
      "name": "CT DICOM Upload (zip recommended)",
      "request": {
        "method": "POST",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "clinical_indication", "type": "text", "value": "Abdominal pain" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/radiology/ct-interpretation/dicom",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "radiology", "ct-interpretation", "dicom"]
        }
      }
    }
  ],
  "variable": [{ "key": "base_url", "value": "http://localhost:8015" }]
}
