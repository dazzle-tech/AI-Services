{
  "template_name": "Standard Discharge Report Template",
  "version": "1.0",
  "description": "Template structure for discharge report validation",
  "sections": [
    {
      "name": "patient_info",
      "required": true,
      "description": "Patient demographic and admission information",
      "fields": [
        {
          "name": "age",
          "required": true,
          "type": "number",
          "description": "Patient age in years"
        },
        {
          "name": "sex",
          "required": true,
          "type": "string",
          "description": "Patient sex/gender"
        },
        {
          "name": "admission_date",
          "required": false,
          "type": "string",
          "description": "Admission date (ISO 8601 format)"
        },
        {
          "name": "discharge_date",
          "required": false,
          "type": "string",
          "description": "Discharge date (ISO 8601 format)"
        }
      ],
      "patterns": [
        "(?i)(patient\\s+info|demographics|patient\\s+demographics)"
      ]
    },
    {
      "name": "encounter_summary",
      "required": true,
      "description": "Summary of the encounter and hospital stay",
      "fields": [
        {
          "name": "chief_complaint",
          "required": true,
          "type": "string",
          "description": "Primary reason for admission"
        },
        {
          "name": "history_of_present_illness",
          "required": false,
          "type": "string",
          "description": "Detailed history of current illness"
        },
        {
          "name": "hospital_course",
          "required": true,
          "type": "string",
          "description": "Summary of hospital stay and treatment"
        }
      ],
      "patterns": [
        "(?i)(encounter\\s+summary|chief\\s+complaint|history\\s+of\\s+present\\s+illness|hospital\\s+course)"
      ]
    },
    {
      "name": "diagnoses",
      "required": true,
      "description": "Diagnoses for this encounter",
      "fields": [
        {
          "name": "primary_diagnosis",
          "required": true,
          "type": "string",
          "description": "Primary diagnosis"
        },
        {
          "name": "secondary_diagnoses",
          "required": false,
          "type": "array",
          "description": "List of secondary diagnoses"
        }
      ],
      "patterns": [
        "(?i)(diagnos(?:is|es)|final\\s+diagnos(?:is|es))"
      ]
    },
    {
      "name": "procedures_and_tests",
      "required": false,
      "description": "Procedures, imaging, and lab tests performed",
      "fields": [
        {
          "name": "procedures",
          "required": false,
          "type": "array",
          "description": "List of procedures performed"
        },
        {
          "name": "imaging",
          "required": false,
          "type": "array",
          "description": "Imaging studies performed"
        },
        {
          "name": "labs",
          "required": false,
          "type": "array",
          "description": "Laboratory tests performed"
        }
      ],
      "patterns": [
        "(?i)(procedures?|tests?|imaging)"
      ]
    },
    {
      "name": "medications",
      "required": true,
      "description": "Medication information",
      "fields": [
        {
          "name": "discharge_medications",
          "required": true,
          "type": "array",
          "description": "Medications prescribed at discharge",
          "item_structure": {
            "name": "string (required)",
            "dose": "string (required)",
            "frequency": "string (required)",
            "route": "string (recommended)",
            "duration": "string (optional)",
            "instructions": "string (optional)"
          }
        },
        {
          "name": "home_medications",
          "required": false,
          "type": "array",
          "description": "Medications patient was taking at home"
        },
        {
          "name": "medication_changes",
          "required": false,
          "type": "array",
          "description": "Changes made to medications during stay"
        }
      ],
      "patterns": [
        "(?i)(medication|medications|meds|discharge\\s+medications)"
      ]
    },
    {
      "name": "allergies",
      "required": true,
      "description": "Allergy information",
      "fields": [
        {
          "name": "allergies",
          "required": true,
          "type": "array",
          "description": "List of known allergies (empty if NKDA)"
        },
        {
          "name": "allergy_notes",
          "required": false,
          "type": "string",
          "description": "Additional allergy information"
        }
      ],
      "patterns": [
        "(?i)(allerg(?:y|ies)|allergic\\s+reactions?)"
      ]
    },
    {
      "name": "vitals_and_key_results",
      "required": false,
      "description": "Vital signs and key test results",
      "fields": [
        {
          "name": "vitals_last",
          "required": false,
          "type": "object",
          "description": "Last recorded vital signs",
          "structure": {
            "bp": "string (e.g., '120/80')",
            "hr": "string (e.g., '72')",
            "rr": "string (e.g., '16')",
            "temp": "string (e.g., '98.6')",
            "o2_sat": "string (e.g., '98')"
          }
        },
        {
          "name": "key_results",
          "required": false,
          "type": "array",
          "description": "Key test results or findings"
        }
      ],
      "patterns": [
        "(?i)(vitals|vital\\s+signs|vitals\\s+and\\s+key\\s+results)"
      ]
    },
    {
      "name": "follow_up_and_instructions",
      "required": true,
      "description": "Follow-up care and patient instructions",
      "fields": [
        {
          "name": "follow_up_appointments",
          "required": false,
          "type": "array",
          "description": "Scheduled follow-up appointments"
        },
        {
          "name": "return_precautions",
          "required": true,
          "type": "array",
          "description": "When to return to ED or seek care"
        },
        {
          "name": "patient_instructions",
          "required": false,
          "type": "string",
          "description": "General patient instructions"
        }
      ],
      "patterns": [
        "(?i)(follow\\s+up|follow\\s+up\\s+instructions|discharge\\s+instructions)"
      ]
    },
    {
      "name": "disposition",
      "required": true,
      "description": "Discharge disposition and condition",
      "fields": [
        {
          "name": "discharge_disposition",
          "required": true,
          "type": "string",
          "description": "Where patient is being discharged to"
        },
        {
          "name": "condition_on_discharge",
          "required": false,
          "type": "string",
          "description": "Patient condition at discharge"
        }
      ],
      "patterns": [
        "(?i)(disposition|discharge\\s+disposition)"
      ]
    },
    {
      "name": "providers_and_signoff",
      "required": false,
      "description": "Provider information and signoff",
      "fields": [
        {
          "name": "service_department",
          "required": false,
          "type": "string",
          "description": "Service/department responsible"
        },
        {
          "name": "author_role",
          "required": false,
          "type": "string",
          "description": "Role of report author"
        },
        {
          "name": "signoff_date",
          "required": false,
          "type": "string",
          "description": "Date of signoff (ISO 8601 format)"
        }
      ],
      "patterns": [
        "(?i)(service|department|author|signoff|physician)"
      ]
    }
  ],
  "section_order": [
    "patient_info",
    "encounter_summary",
    "diagnoses",
    "procedures_and_tests",
    "medications",
    "allergies",
    "vitals_and_key_results",
    "follow_up_and_instructions",
    "disposition",
    "providers_and_signoff"
  ],
  "required_fields_summary": {
    "patient_info": ["age", "sex"],
    "encounter_summary": ["chief_complaint", "hospital_course"],
    "diagnoses": ["primary_diagnosis"],
    "medications": ["discharge_medications"],
    "allergies": ["allergies"],
    "follow_up_and_instructions": ["return_precautions"],
    "disposition": ["discharge_disposition"]
  }
}

