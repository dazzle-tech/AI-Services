# OpenAI
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:1.7b
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_TEMPERATURE=0.1

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage
TEMPLATES_DIR=data/templates
VECTOR_STORE_PATH=./vector_store_templates

# API
API_HOST=0.0.0.0
API_PORT=8022
API_RELOAD=False

# CORS (comma-separated, or "*" for all)
CORS_ORIGINS=*

# Set to "true" to run service without calling OpenAI (mock autofill - prototyping only)
MOCK_LLM=false
