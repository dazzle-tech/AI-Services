{
  "info": {
    "name": "Radiology Template Selection & Autofill",
    "description": "Two-stage radiology reporting API. Stage 1: RAG (or static) template selection. Stage 2: LLM autofill of the selected template from clinician input.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8013",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Service info."
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Health check."
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/templates",
              "host": ["{{base_url}}"],
              "path": ["templates"]
            }
          }
        },
        {
          "name": "Get Template (CT Chest)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/templates/ct_chest",
              "host": ["{{base_url}}"],
              "path": ["templates", "ct_chest"]
            }
          }
        },
        {
          "name": "Get Template (MRI Brain)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/templates/mri_brain",
              "host": ["{{base_url}}"],
              "path": ["templates", "mri_brain"]
            }
          }
        }
      ]
    },
    {
      "name": "Sample Inputs",
      "item": [
        {
          "name": "List Samples",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/samples",
              "host": ["{{base_url}}"],
              "path": ["samples"]
            }
          }
        },
        {
          "name": "Get Sample (CT Chest PE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/samples/ct_chest_pe",
              "host": ["{{base_url}}"],
              "path": ["samples", "ct_chest_pe"]
            }
          }
        }
      ]
    },
    {
      "name": "Stage 1 - Template Selection",
      "item": [
        {
          "name": "Select via RAG (CT chest PE)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_data\": \"55-year-old male with acute shortness of breath and pleuritic chest pain. CT pulmonary angiogram performed with IV contrast. Filling defects in the right lower lobe segmental pulmonary arteries consistent with acute pulmonary embolism. Small right pleural effusion.\",\n  \"use_static_template\": false,\n  \"top_k\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/select-template",
              "host": ["{{base_url}}"],
              "path": ["select-template"]
            },
            "description": "RAG-based selection; should pick ct_chest."
          }
        },
        {
          "name": "Select via RAG (MRI brain stroke)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_data\": \"68-year-old with sudden right-sided weakness. DWI shows acute left MCA territory infarct. No hemorrhage on SWI.\",\n  \"top_k\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/select-template",
              "host": ["{{base_url}}"],
              "path": ["select-template"]
            }
          }
        },
        {
          "name": "Select via RAG (US abdomen RUQ)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_data\": \"Right upper quadrant ultrasound for gallstones. Gallbladder distended with multiple mobile stones and wall thickening.\",\n  \"top_k\": 3\n}"
            },
            "url": {
              "raw": "{{base_url}}/select-template",
              "host": ["{{base_url}}"],
              "path": ["select-template"]
            }
          }
        },
        {
          "name": "Select via Static Override",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_data\": \"Any input — will be ignored because we are forcing a template.\",\n  \"use_static_template\": true,\n  \"static_template_id\": \"mammography_screening\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/select-template",
              "host": ["{{base_url}}"],
              "path": ["select-template"]
            }
          }
        }
      ]
    },
    {
      "name": "Stage 2 - Autofill",
      "item": [
        {
          "name": "Autofill CT Chest (PE)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_id\": \"ct_chest\",\n  \"input_data\": \"55-year-old male with acute shortness of breath and pleuritic chest pain. D-dimer elevated. CT pulmonary angiogram performed with 75 mL of Omnipaque 350 IV contrast. Filling defects in the right lower lobe segmental pulmonary arteries consistent with acute pulmonary embolism. No right heart strain. Small right pleural effusion. No focal consolidation. Heart size normal. No mediastinal lymphadenopathy. Visualized upper abdomen unremarkable.\",\n  \"patient_context\": {\n    \"age\": 55,\n    \"sex\": \"M\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/autofill",
              "host": ["{{base_url}}"],
              "path": ["autofill"]
            }
          }
        },
        {
          "name": "Autofill MRI Lumbar Spine",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_id\": \"mri_lumbar_spine\",\n  \"input_data\": \"45-year-old with chronic low back pain radiating to left leg, L5 distribution. Sagittal T1, T2, STIR and axial T2 sequences obtained. Alignment maintained. Mild disc desiccation L4-L5 and L5-S1. Left paracentral disc protrusion at L4-L5 contacting the left L5 nerve root. Moderate left foraminal narrowing at L5-S1. Conus terminates at L1, normal signal. No marrow lesion.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/autofill",
              "host": ["{{base_url}}"],
              "path": ["autofill"]
            }
          }
        }
      ]
    },
    {
      "name": "Combined - Select + Autofill",
      "item": [
        {
          "name": "Select & Fill (RAG, CT chest PE)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_data\": \"55-year-old male with acute shortness of breath and pleuritic chest pain. D-dimer elevated. CT pulmonary angiogram performed with IV contrast. Filling defects in the right lower lobe segmental pulmonary arteries consistent with acute pulmonary embolism. No right heart strain. Small right pleural effusion. No focal consolidation.\",\n  \"top_k\": 3,\n  \"patient_context\": {\"age\": 55, \"sex\": \"M\"}\n}"
            },
            "url": {
              "raw": "{{base_url}}/select-and-fill",
              "host": ["{{base_url}}"],
              "path": ["select-and-fill"]
            }
          }
        },
        {
          "name": "Select & Fill (Static, Mammography)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_data\": \"Bilateral screening mammogram with tomosynthesis. Scattered fibroglandular densities. No suspicious masses, calcifications, asymmetries, or architectural distortion. Comparison with prior shows stability.\",\n  \"use_static_template\": true,\n  \"static_template_id\": \"mammography_screening\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/select-and-fill",
              "host": ["{{base_url}}"],
              "path": ["select-and-fill"]
            }
          }
        }
      ]
    }
  ]
}
