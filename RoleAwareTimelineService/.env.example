# OpenAI configuration. Set these in a local .env file. Do not commit that file.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
# Required. Choose the OpenAI model for this deployment. The service does not default one.
OPENAI_MODEL=
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=2

# API server
API_HOST=0.0.0.0
API_PORT=8040
API_RELOAD=False

# Logging
LOG_LEVEL=INFO

# Service
ENABLE_USAGE_TRACKING=True
MAX_INPUT_LENGTH=200000
