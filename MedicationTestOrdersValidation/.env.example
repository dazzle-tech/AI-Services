HOST=0.0.0.0
PORT=8006
DEBUG=False

# Local Ollama default. Leave OPENAI_BASE_URL empty and provide a real
# OPENAI_API_KEY to route the same client back to the OpenAI cloud API.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2000
