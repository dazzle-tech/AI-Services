# Server
PORT=8013
HOST=0.0.0.0

# Whisper model: tiny, base, small, medium, large-v2, large-v3
# Spec recommends "medium" or "large-v3"
WHISPER_MODEL=medium

# auto | cuda | cpu
WHISPER_DEVICE=auto

# float16 (GPU) | int8_float16 (GPU, less VRAM) | int8 (CPU) | float32
# Leave blank for sensible default based on device.
WHISPER_COMPUTE_TYPE=

# Language hint: "en" forces English. Leave blank for auto-detect.
WHISPER_LANGUAGE=en

# Path to a directory where faster-whisper caches model weights
# (defaults to ~/.cache/huggingface).
WHISPER_MODEL_CACHE=

# Path to the radiology lexicon used as Whisper's initial_prompt
RADIOLOGY_PROMPT_PATH=prompts/radiology_lexicon.txt

# Streaming chunking
STREAM_CHUNK_SECONDS=4.0
STREAM_OVERLAP_SECONDS=0.5

# Max upload size in MB
MAX_UPLOAD_MB=200
