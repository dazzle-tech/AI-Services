{
  "info": {
    "_postman_id": "patient-timeline-service",
    "name": "PatientTimelineService",
    "description": "Postman collection for Patient Timeline Service REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Check service health and OpenAI configuration status."
      },
      "response": []
    },
    {
      "name": "Generate Timeline (Minimal)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has timeline array', function () {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.have.property('timeline');",
              "  pm.expect(jsonData.timeline).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"postman-minimal-001\",\n  \"patient_data\": {\n    \"patient_id\": \"12345\",\n    \"demographics\": {\n      \"age\": \"58 years\",\n      \"gender\": \"Male\"\n    },\n    \"diagnoses\": [\n      {\n        \"name\": \"Hypertension\",\n        \"date\": \"2021-03-10\"\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/generate-timeline",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "generate-timeline"
          ]
        },
        "description": "Generate a timeline with the minimum clinically useful payload."
      },
      "response": []
    },
    {
      "name": "Generate Timeline (Full Example)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has timeline array', function () {",
              "  var jsonData = pm.response.json();",
              "  pm.expect(jsonData).to.have.property('timeline');",
              "  pm.expect(jsonData.timeline).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"req-123\",\n  \"patient_data\": {\n    \"patient_id\": \"12345\",\n    \"demographics\": {\n      \"age\": \"58 years\",\n      \"gender\": \"Male\"\n    },\n    \"diagnoses\": [\n      {\n        \"name\": \"Type 2 Diabetes\",\n        \"date\": \"2022-05-01\"\n      },\n      {\n        \"name\": \"Hypertension\",\n        \"date\": \"2021-03-10\"\n      }\n    ],\n    \"medications\": [\n      {\n        \"name\": \"Metformin\",\n        \"start_date\": \"2022-05-02\",\n        \"end_date\": null,\n        \"status\": \"active\"\n      },\n      {\n        \"name\": \"Insulin\",\n        \"start_date\": \"2023-11-18\",\n        \"end_date\": null,\n        \"status\": \"active\"\n      }\n    ],\n    \"lab_results\": [\n      {\n        \"name\": \"Troponin\",\n        \"value\": \"0.8\",\n        \"unit\": \"ng/mL\",\n        \"date\": \"2026-03-13\",\n        \"flag\": \"high\"\n      }\n    ],\n    \"vitals\": [\n      {\n        \"name\": \"BP\",\n        \"value\": \"160/100\",\n        \"date\": \"2026-03-12\"\n      }\n    ],\n    \"procedures\": [\n      {\n        \"name\": \"Coronary angiography\",\n        \"date\": \"2020-02-15\",\n        \"status\": \"completed\"\n      }\n    ],\n    \"encounters\": [\n      {\n        \"type\": \"admission\",\n        \"date\": \"2026-03-12\",\n        \"reason\": \"Chest pain\"\n      }\n    ],\n    \"notes\": [\n      {\n        \"date\": \"2026-03-12\",\n        \"author\": \"Dr. Smith\",\n        \"type\": \"admission_note\",\n        \"text\": \"Patient admitted with chest pain and shortness of breath.\"\n      }\n    ],\n    \"allergies\": [\n      {\n        \"name\": \"Penicillin\",\n        \"date\": \"2020-01-01\"\n      }\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/generate-timeline",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "generate-timeline"
          ]
        },
        "description": "Generate a full patient timeline from structured and note-derived data."
      },
      "response": []
    },
    {
      "name": "Generate Timeline (Invalid Payload)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 or 422', function () {",
              "  pm.expect([400, 422]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"request_id\": \"postman-invalid-001\",\n  \"patient_data\": {\n    \"demographics\": {\n      \"age\": \"58 years\",\n      \"gender\": \"Male\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/generate-timeline",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "generate-timeline"
          ]
        },
        "description": "Send an invalid request missing required patient_id to verify validation handling."
      },
      "response": []
    }
  ],
