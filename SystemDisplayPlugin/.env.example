# API
API_HOST=0.0.0.0
API_PORT=8031
API_KEY=change-me-to-a-secure-random-key
LOG_LEVEL=INFO
API_RELOAD=false

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
MAPPING_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=1
OPENAI_RETRY_DELAY=1.0
ENABLE_USAGE_TRACKING=true
USE_LLM_STUB=false

# PostgreSQL
# Host (py main.py): localhost:5435  |  Docker (api): postgres:5432
DATABASE_URL=postgresql://systemdisplay:systemdisplay@localhost:5435/systemdisplay

# Redis (health check only)
# Host: localhost:6382  |  Docker: redis:6379
REDIS_URL=redis://localhost:6382/0
